{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muster",
  "main": "src/index.ts",
  // Set to today's date when starting new work; it gates runtime behaviour changes.
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },

  // M1：账号/用户/身份的权威库。本地开发与测试都只用 workerd 自带的本地 D1，
  // 不连任何远端资源（因此不产生账单）。database_id 是占位值，真正部署时替换。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muster",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // M8：运行时模块宿主。每个租户的游戏脚本由这条绑定在运行时装载进**独立的
  // isolate**（不是 eval，不是同进程 import）：一个租户的脚本读不到另一个租户的
  // 全局状态，也不共享内存。本地开发与测试同样只跑在 workerd 里。
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  // M3：持久对象。会话分片一个 WebSocket 一个实例；会话注册表每租户一个实例。
  // 都用 SQLite 后端（`new_sqlite_classes`），本地跑在 workerd 里，不产生账单。
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_SHARD", "class_name": "SessionShard" },
      { "name": "SESSION_REGISTRY", "class_name": "SessionRegistry" },
      { "name": "CHANNEL", "class_name": "Channel" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "MATCH", "class_name": "Match" },
      // M8：一个派对一个实例。成员表、加入请求、队长与广播顺序都要单点定序。
      { "name": "PARTY", "class_name": "Party" },
      // M9：一个租户一个限流实例。计数必须单点（每个 isolate 各记一份等于没限），
      // 桶只活在内存里、不落库（ECN-0014 偏差 4）。只跑本地 workerd。
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    {
      "tag": "m3-sessions",
      "new_sqlite_classes": ["SessionShard", "SessionRegistry"]
    },
    {
      // M4：一个频道一个实例。成员与消息都存 SQLite（本地跑在 workerd 里，不产生账单）。
      "tag": "m4-channels",
      "new_sqlite_classes": ["Channel"]
    },
    {
      // M7：一个租户一个匹配池（成局要有单点看整个池子），一场对局一个实例
      // （成员快照与广播顺序靠单点定序）。同样只跑本地 workerd，不产生账单。
      "tag": "m7-matches",
      "new_sqlite_classes": ["Matchmaker", "Match"]
    },
    {
      // M8：一个派对一个实例，成员/请求/队长都存 SQLite。只跑本地 workerd。
      "tag": "m8-parties",
      "new_sqlite_classes": ["Party"]
    },
    {
      // M9：限流实例。它不写存储（桶在内存里），但仍然要声明成 SQLite 类：
      // 这样它跟其余 DO 走同一条迁移路径，将来要加持久桶不必再改迁移历史。
      "tag": "m9-rate-limiter",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]

  // Bindings are introduced milestone by milestone:
  //   M4: Durable Object namespace (channel)
  //   M7: Durable Object namespaces (matchmaker, match)
  //   secrets（如 SESSION_ENCRYPTION_KEY）不进仓库：本地用 --var 或 .dev.vars，
  //   线上用 `wrangler secret put`。缺了它认证端点会明确报错，而不是悄悄用一个弱默认值。
}
